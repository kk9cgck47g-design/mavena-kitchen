# --- Demo mode -------------------------------------------------------------
# "1" serves the menu from src/server/db/menu-data.ts instead of Postgres and
# refuses to create orders. This is what the public design preview runs on:
# no database, no secrets, nothing that can take a real order.
# Leave unset (or "0") for a real deployment.
NEXT_PUBLIC_DEMO_MODE="0"

# --- Database -------------------------------------------------------------
# Local dev uses docker-compose (see docker-compose.yml).
# Production: Neon / any Postgres 16 connection string.
# Not required when NEXT_PUBLIC_DEMO_MODE=1.
DATABASE_URL="postgresql://mavena:mavena_local_dev@localhost:5432/mavena_kitchen"
#
# Whether DATABASE_URL points at a transaction-mode pooler. Normally leave unset:
# it is worked out from the hostname, which is right for Neon's -pooler endpoint
# and Supabase's 6543. Set "1" when the guess is wrong — a PgBouncer on a hostname
# that says nothing about itself. Getting this wrong towards "not pooled" is the
# expensive mistake: prepared statements then fail on a fraction of requests, but
# only once traffic is heavy enough for connections to be reused.
DATABASE_POOLED=""

# --- Public site ----------------------------------------------------------
# Used for absolute URLs in Telegram messages and order-tracking links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Testing on a real phone ----------------------------------------------
# The dev server serves /_next/* to localhost and nothing else, so opening the
# site from a handset on the same network renders the HTML and then 403s on
# every client chunk — the page appears but nothing on it works. Put this
# machine's LAN address here to allow it. Comma separated, no scheme, no port,
# and restart `next dev` afterwards. Dev only: `next build` ignores it.
DEV_ALLOWED_ORIGINS=""

# --- Maps -----------------------------------------------------------------
# MapTiler free tier key, and a real deployment needs one.
#
# Empty falls back to raw OSM raster tiles from tile.openstreetmap.org. That is
# fine for development and for the design preview, and it is NOT fine for a shop
# taking orders: those tiles are donation-funded and the OSM Foundation's Tile
# Usage Policy does not cover commercial use. The fallback also draws lighter
# than the rest of the interface, where a key gets the dark style.
#
# `NEXT_PUBLIC_` is correct and deliberate: MapLibre fetches tiles from the
# browser, so the key is public wherever it is kept, and MapTiler issues these as
# browser keys. Protect it the way it is meant to be protected — restrict the key
# to your own domains in the MapTiler dashboard and set a quota alert. There is
# nothing to hide here, only something to restrict.
NEXT_PUBLIC_MAPTILER_KEY=""

# --- Telegram notifications ----------------------------------------------
# Create a bot via @BotFather; the token it gives you goes here. Without it the
# app runs normally and simply notifies nobody — queued messages stay in the
# outbox and can be sent once a token exists.
TELEGRAM_BOT_TOKEN=""
#
# Any long random string; generate with: openssl rand -hex 32
# Pass the SAME value as `secret_token` when registering the webhook:
#   curl -F "url=https://YOUR-DOMAIN/api/telegram" \
#        -F "secret_token=THIS_VALUE" \
#        https://api.telegram.org/botYOUR_TOKEN/setWebhook
# Without it the webhook answers 404 and the status buttons in Telegram do
# nothing — closed rather than open.
TELEGRAM_WEBHOOK_SECRET=""
#
# Chat IDs are NOT set here. They live on the settings row and are edited in the
# admin panel (Telegram tab), because a chat id only exists once the bot has
# been added to a group — which happens after the deployment does.

# --- Scheduled jobs -------------------------------------------------------
# Guards both /api/cron/telegram (re-sends anything still queued in the
# notifications outbox) and /api/cron/payments (asks the provider about payments
# still outstanding, and cancels online orders whose window has closed).
# Vercel Cron sends this automatically as `Authorization: Bearer <value>` once
# the variable exists on the project.
# Generate with: openssl rand -hex 32
# Without it both endpoints answer 404 — closed rather than open.
#
# The Telegram sweep is optional: an undelivered ticket is something a person
# notices, and it can be re-sent by hand from the panel.
#
# The payment sweep is NOT optional once PAYMENT_PROVIDER is set. It is the only
# thing that recovers a customer who paid and closed the tab before the return
# fired — from the outside that is indistinguishable from a customer who did not
# pay, so without the sweep the order is cancelled and the money stays taken.
# See the payments section of README.md.
CRON_SECRET=""

# --- Online payment -------------------------------------------------------
# Which adapter takes money. Unset means online payment is not offered at all:
# the checkout shows cash and card-on-delivery only, and the server refuses
# ONLINE if it is asked for anyway. That is the correct state until there is an
# acquiring contract.
#
#   stub  — a payment provider that takes no money. Implements the full redirect
#           flow against a page on this site, so the whole path (checkout →
#           redirect → success/decline → return → reconciliation → the kitchen
#           being told) can be walked and tested locally. Never set this on a
#           deployment customers can reach.
#
# A real acquirer is added to `src/server/payments/registry.ts` and to the enum
# in `src/lib/env.ts`; nothing else in the system changes.
PAYMENT_PROVIDER=""

# --- Images ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Auth (admin panel only, no public registration) ----------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
#
# The password for the very first owner account, used once by `pnpm db:seed` and
# only when no staff account exists yet. Everything after that is created by the
# owner in the panel (Сотрудники), which is also where passwords are changed.
#
# Against a non-local database the seed refuses to fall back to the development
# default and insists on this being set: a password documented in a repository is
# a convenience on a laptop and a published credential on a deployment.
SEED_ADMIN_PASSWORD=""
